NODE_ENV=production
PORT=3000
APP_URL="https://api.tu-dominio.com"
API_PREFIX="api"
DOCS_PATH="docs"
DOCS_ENABLED=false
CORS_ORIGINS="https://tienda1.tu-dominio.com,https://tienda2.tu-dominio.com,https://admin.tu-dominio.com"

DATABASE_URL="postgresql://usuario:password@host:5432/ecommerce"
JWT_SECRET="cambiar-por-un-secreto-largo-y-unico"

REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

UPLOADS_DIR="/var/www/ecommerce/shared/uploads"
PRIVATE_UPLOADS_DIR="/var/www/ecommerce/shared/private-uploads"

AUTH_COOKIE_NAME="ecommerce_session"
AUTH_COOKIE_DOMAIN=".tu-dominio.com"
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE="none"

RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
WEBHOOK_RATE_LIMIT_MAX=120

MERCADOPAGO_WEBHOOK_SECRET=""
ENVIOPACK_API_KEY=""
ENVIOPACK_SECRET_KEY=""
ENVIOPACK_WEBHOOK_SECRET=""
CORREO_ARGENTINO_API_BASE_URL=""
CORREO_ARGENTINO_API_USERNAME=""
CORREO_ARGENTINO_API_PASSWORD=""

EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_NOTIFICATIONS_FROM="no-reply@tu-dominio.com"
EMAIL_NOTIFICATIONS_FROM_NAME="Ecommerce"
STOREFRONT_PUBLIC_URL="https://tienda1.tu-dominio.com"
