generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                             Int                           @id @default(autoincrement())
  name                           String
  domain                         String                        @unique
  mercadoPagoAccessToken         String?
  mercadoPagoPublicKey           String?
  mercadoPagoWebhookSecret       String?
  bankTransferAlias              String?
  bankTransferDiscountPercentage Float                         @default(0)
  manualSalesEnabled             Boolean                       @default(false)
  cashRegisterMode               String                        @default("automatic")
  storefrontConfig               Json?
  createdAt                      DateTime                      @default(now())
  catalogAuditLogs               CatalogAuditLog[]
  cancellationRequests           CancellationRequest[]
  carts                          Cart[]
  cashRegisterSessions           CashRegisterSession[]
  categories                     Category[]
  currentAccounts                CurrentAccount[]
  currentAccountMovements        CurrentAccountMovement[]
  coupons                        Coupon[]
  customers                      Customer[]
  customerAddresses              CustomerAddress[]
  discounts                      Discount[]
  orders                         Order[]
  payments                       Payment[]
  products                       Product[]
  productOptions                 ProductOption[]
  productTrials                  ProductTrial[]
  productTrialItems              ProductTrialItem[]
  productTrialEvents             ProductTrialEvent[]
  refunds                        Refund[]
  returns                        Return[]
  manualReturns                  ManualReturn[]
  shipments                      Shipment[]
  shippingQuotes                 ShippingQuote[]
  storeShippingMethods           StoreShippingMethod[]
  storeShippingProviderConfigs   StoreShippingProviderConfig[]
  storeLocations                 StoreLocation[]
  users                          User[]
  webhooks                       Webhook[]

  @@index([domain])
}

model StoreLocation {
  id                      Int                      @id @default(autoincrement())
  storeId                 Int
  name                    String
  address                 String?
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  store                   Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  users                   User[]
  orders                  Order[]
  payments                Payment[]
  currentAccounts         CurrentAccount[]
  cashRegisterSessions    CashRegisterSession[]
  currentAccountMovements CurrentAccountMovement[]
  manualReturns           ManualReturn[]
  productTrials           ProductTrial[]

  @@unique([storeId, name])
  @@index([storeId, active])
}

model Category {
  id              Int                @id @default(autoincrement())
  name            String
  slug            String
  description     String?
  status          String             @default("active")
  parentId        Int?
  storeId         Int
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  imageUrl        String?
  parent          Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[]         @relation("CategoryHierarchy")
  store           Store              @relation(fields: [storeId], references: [id])
  discountTargets DiscountCategory[]
  products        ProductCategory[]

  @@unique([slug, storeId])
  @@index([storeId])
  @@index([parentId])
}

model ProductCategory {
  productId  Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model Product {
  id                  Int                  @id @default(autoincrement())
  title               String
  description         String?
  storeId             Int
  weightGrams         Float?
  packageHeightCm     Float?
  packageWidthCm      Float?
  packageLengthCm     Float?
  packagingTemplateId String?
  createdAt           DateTime             @default(now())
  published           Boolean              @default(false)
  slug                String
  deletedAt           DateTime?
  auditLogs           CatalogAuditLog[]
  discountTargets     DiscountProduct[]
  store               Store                @relation(fields: [storeId], references: [id])
  categories          ProductCategory[]
  images              ProductImage[]
  optionValues        ProductOptionValue[]
  variants            ProductVariant[]

  @@unique([slug, storeId])
  @@index([storeId, published])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  position  Int     @default(0)
  offsetX   Float   @default(0)
  offsetY   Float   @default(0)
  zoom      Float   @default(1)
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId, position])
}

model ProductVariant {
  id                Int                @id @default(autoincrement())
  productId         Int
  sku               String
  price             Decimal            @db.Decimal(10, 2)
  weightGrams       Float?
  packageHeightCm   Float?
  packageWidthCm    Float?
  packageLengthCm   Float?
  height            Float?
  length            Float?
  weight            Float?
  width             Float?
  deletedAt         DateTime?
  Color             String?
  Size              String?
  waistSize         String?
  auditLogs         CatalogAuditLog[]
  cartItems         CartItem[]
  discountTargets   DiscountVariant[]
  inventories       Inventory[]
  manualReturnItems ManualReturnItem[]
  orderItems        OrderItem[]
  productTrialItems ProductTrialItem[]
  product           Product            @relation(fields: [productId], references: [id])

  @@index([productId, deletedAt])
}

model ProductOption {
  id                 Int                          @id @default(autoincrement())
  name               String
  storeId            Int
  attributeType      String                       @default("text")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  discountTargets    DiscountOption[]
  optionValueTargets DiscountOptionValue[]
  reusableValues     ProductOptionReusableValue[]
  store              Store                        @relation(fields: [storeId], references: [id])
  values             ProductOptionValue[]

  @@unique([storeId, name])
  @@index([storeId])
}

model ProductOptionReusableValue {
  id              Int           @id @default(autoincrement())
  productOptionId Int
  value           String
  position        Int           @default(0)
  visualColor     String?
  createdAt       DateTime      @default(now())
  productOption   ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  @@unique([productOptionId, value])
  @@index([productOptionId, position])
}

model ProductOptionValue {
  id              Int           @id @default(autoincrement())
  productOptionId Int
  productId       Int
  value           String
  createdAt       DateTime      @default(now())
  product         Product       @relation(fields: [productId], references: [id])
  productOption   ProductOption @relation(fields: [productOptionId], references: [id])

  @@unique([productOptionId, productId, value])
  @@index([productOptionId])
  @@index([productId])
}

model Inventory {
  id        Int            @id @default(autoincrement())
  variantId Int
  quantity  Int
  reserved  Int            @default(0)
  updatedAt DateTime       @updatedAt
  storeId   Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([storeId, variantId])
  @@index([storeId])
}

model CatalogAuditLog {
  id          Int             @id @default(autoincrement())
  storeId     Int
  productId   Int?
  variantId   Int?
  actorUserId Int?
  actorEmail  String?
  actorName   String?
  action      String
  entity      String
  entityId    Int?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime        @default(now())
  actorUser   User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([storeId, productId, createdAt])
  @@index([storeId, variantId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

model Order {
  id                          Int                          @id @default(autoincrement())
  storeId                     Int
  storeLocationId             Int?
  cashRegisterId              Int?
  customerId                  Int
  total                       Decimal                      @db.Decimal(10, 2)
  createdAt                   DateTime                     @default(now())
  status                      OrderStatus
  shippingCost                Decimal?                     @db.Decimal(10, 2)
  shippingMethod              String?
  shippingProvider            String?
  deletedAt                   DateTime?
  discountAmount              Decimal                      @default(0) @db.Decimal(10, 2)
  discountCode                String?
  discountId                  Int?
  subtotal                    Decimal                      @db.Decimal(10, 2)
  idempotencyKey              String?
  customerEmailSnapshot       String?
  customerFirstNameSnapshot   String?
  customerLastNameSnapshot    String?
  customerPhoneSnapshot       String?
  shippingFirstNameSnapshot   String?
  shippingLastNameSnapshot    String?
  shippingPhoneSnapshot       String?
  shippingAddress1Snapshot    String?
  shippingAddress2Snapshot    String?
  shippingCitySnapshot        String?
  shippingStateSnapshot       String?
  shippingPostalCodeSnapshot  String?
  shippingCountrySnapshot     String?
  shippingCarrierId           String?
  shippingCarrierName         String?
  shippingServiceCode         String?
  shippingModalityCode        String?
  shippingDispatchType        String?
  shippingBranchId            String?
  shippingProviderConfigId    String?
  shippingQuoteId             String?
  customerNotesSnapshot       String?
  reservationExpiresAt        DateTime?
  cancellationRequest         CancellationRequest?
  customer                    Customer                     @relation(fields: [customerId], references: [id])
  discount                    Discount?                    @relation(fields: [discountId], references: [id])
  storeShippingProviderConfig StoreShippingProviderConfig? @relation(fields: [shippingProviderConfigId], references: [id])
  shippingQuote               ShippingQuote?               @relation(fields: [shippingQuoteId], references: [id])
  store                       Store                        @relation(fields: [storeId], references: [id])
  storeLocation               StoreLocation?               @relation(fields: [storeLocationId], references: [id], onDelete: SetNull)
  cashRegister                CashRegisterSession?         @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  events                      OrderEvent[]
  currentAccountMovements     CurrentAccountMovement[]
  items                       OrderItem[]
  payments                    Payment[]
  refunds                     Refund[]
  returns                     Return[]
  shipment                    Shipment?
  productTrialItems           ProductTrialItem[]

  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([storeId, storeLocationId])
  @@index([cashRegisterId])
  @@index([shippingProviderConfigId])
  @@index([shippingQuoteId])
  @@index([storeId, status, reservationExpiresAt])
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  storeId   Int
  orderId   Int
  type      String
  title     String
  message   String?
  actorType String?
  actorId   Int?
  actorName String?
  metadata  Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId, orderId, createdAt])
  @@index([storeId, type])
}

model OrderItem {
  id               Int            @id @default(autoincrement())
  orderId          Int
  variantId        Int
  quantity         Int
  price            Decimal        @db.Decimal(10, 2)
  discountAmount   Decimal        @default(0) @db.Decimal(10, 2)
  returnedQuantity Int            @default(0)
  order            Order          @relation(fields: [orderId], references: [id])
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  returnItems      ReturnItem[]

  @@index([orderId])
}

model User {
  id                      Int                      @id @default(autoincrement())
  email                   String
  password                String
  name                    String?
  role                    Role
  storeId                 Int
  storeLocationId         Int?
  createdAt               DateTime                 @default(now())
  catalogAuditLogs        CatalogAuditLog[]
  store                   Store                    @relation(fields: [storeId], references: [id])
  storeLocation           StoreLocation?           @relation(fields: [storeLocationId], references: [id], onDelete: SetNull)
  currentAccountMovements CurrentAccountMovement[]
  productTrials           ProductTrial[]
  manualReturnEvents      ManualReturnEvent[]

  @@unique([storeId, email])
  @@index([storeId])
  @@index([storeId, storeLocationId])
}

model Customer {
  id                      Int                      @id @default(autoincrement())
  email                   String?
  googleId                String?
  storeId                 Int
  createdAt               DateTime                 @default(now())
  firstName               String?
  lastName                String?
  phone                   String?
  document                String?
  notes                   String?
  source                  String                   @default("storefront")
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  password                String?
  cancellationRequests    CancellationRequest[]
  carts                   Cart[]
  currentAccounts         CurrentAccount[]
  currentAccountMovements CurrentAccountMovement[]
  store                   Store                    @relation(fields: [storeId], references: [id])
  addresses               CustomerAddress[]
  orders                  Order[]
  manualReturns           ManualReturn[]
  productTrials           ProductTrial[]

  @@unique([storeId, email])
  @@unique([storeId, googleId])
  @@index([storeId])
  @@index([storeId, source])
  @@index([storeId, phone])
  @@index([storeId, document])
}

model CustomerAddress {
  id         Int      @id @default(autoincrement())
  customerId Int
  firstName  String
  lastName   String
  phone      String?
  address1   String
  address2   String?
  city       String
  state      String?
  zip        String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  storeId    Int
  customer   Customer @relation(fields: [customerId], references: [id])
  store      Store    @relation(fields: [storeId], references: [id])

  @@index([customerId])
  @@index([storeId])
}

model Cart {
  id         Int        @id @default(autoincrement())
  storeId    Int
  customerId Int
  status     String     @default("active")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  customer   Customer   @relation(fields: [customerId], references: [id])
  store      Store      @relation(fields: [storeId], references: [id])
  items      CartItem[]

  @@index([storeId])
  @@index([customerId])
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int
  createdAt DateTime       @default(now())
  cart      Cart           @relation(fields: [cartId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([cartId])
}

model Payment {
  id              Int                  @id @default(autoincrement())
  storeId         Int
  storeLocationId Int?
  cashRegisterId  Int?
  orderId         Int
  provider        String
  status          String
  amount          Decimal              @db.Decimal(10, 2)
  externalId      String?
  createdAt       DateTime             @default(now())
  idempotencyKey  String?
  method          String?
  reference       String?
  proofUrl        String?
  proofFilename   String?
  notes           String?
  metadata        Json?
  reviewedAt      DateTime?
  updatedAt       DateTime             @updatedAt
  order           Order                @relation(fields: [orderId], references: [id])
  store           Store                @relation(fields: [storeId], references: [id])
  storeLocation   StoreLocation?       @relation(fields: [storeLocationId], references: [id], onDelete: SetNull)
  cashRegister    CashRegisterSession? @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)

  @@unique([storeId, idempotencyKey])
  @@index([orderId])
  @@index([storeId, storeLocationId])
  @@index([cashRegisterId])
}

model CurrentAccount {
  id              Int                      @id @default(autoincrement())
  storeId         Int
  storeLocationId Int?
  customerId      Int
  balance         Decimal                  @default(0) @db.Decimal(10, 2)
  lastMovementAt  DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?
  store           Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeLocation   StoreLocation?           @relation(fields: [storeLocationId], references: [id], onDelete: SetNull)
  customer        Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  movements       CurrentAccountMovement[]
  manualReturns   ManualReturn[]
  productTrials   ProductTrial[]

  @@unique([storeId, storeLocationId, customerId])
  @@index([storeId, balance])
  @@index([storeId, storeLocationId])
  @@index([storeId, deletedAt])
  @@index([customerId])
}

model CurrentAccountMovement {
  id                     Int                        @id @default(autoincrement())
  storeId                Int
  storeLocationId        Int?
  accountId              Int
  customerId             Int
  orderId                Int?
  manualReturnId         Int?
  cashRegisterId         Int?
  type                   CurrentAccountMovementType
  amount                 Decimal                    @db.Decimal(10, 2)
  paymentMethod          String?
  description            String?
  createdByUserId        Int?
  createdAt              DateTime                   @default(now())
  balanceAfter           Decimal                    @db.Decimal(10, 2)
  cancelledAt            DateTime?
  cancelledByUserId      Int?
  cancellationReason     String?
  cancellationMovementId Int?
  store                  Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeLocation          StoreLocation?             @relation(fields: [storeLocationId], references: [id], onDelete: SetNull)
  account                CurrentAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer               Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order                  Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  manualReturn           ManualReturn?              @relation(fields: [manualReturnId], references: [id], onDelete: SetNull)
  createdByUser          User?                      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  cashRegister           CashRegisterSession?       @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)

  @@index([storeId, customerId, createdAt])
  @@index([storeId, storeLocationId])
  @@index([storeId, type])
  @@index([orderId])
  @@index([manualReturnId])
  @@index([cashRegisterId])
  @@index([accountId, createdAt])
  @@index([cancelledAt])
  @@index([cancellationMovementId])
}

model ProductTrial {
  id              Int                 @id @default(autoincrement())
  storeId         Int
  storeLocationId Int?
  accountId       Int
  customerId      Int
  status          String              @default("open")
  notes           String?
  createdByUserId Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  completedAt     DateTime?
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeLocation   StoreLocation?      @relation(fields: [storeLocationId], references: [id], onDelete: SetNull)
  account         CurrentAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdByUser   User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           ProductTrialItem[]
  events          ProductTrialEvent[]

  @@index([storeId, storeLocationId, status])
  @@index([accountId, createdAt])
  @@index([customerId])
}

model ProductTrialItem {
  id               Int            @id @default(autoincrement())
  storeId          Int
  trialId          Int
  variantId        Int
  orderId          Int?
  status           String         @default("pending")
  price            Decimal        @db.Decimal(10, 2)
  resolvedAt       DateTime?
  resolvedByUserId Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  trial            ProductTrial   @relation(fields: [trialId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  order            Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([trialId, status])
  @@index([storeId, variantId, status])
  @@index([orderId])
}

model ProductTrialEvent {
  id        Int          @id @default(autoincrement())
  storeId   Int
  trialId   Int
  type      String
  actorId   Int?
  metadata  Json?
  createdAt DateTime     @default(now())
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  trial     ProductTrial @relation(fields: [trialId], references: [id], onDelete: Cascade)

  @@index([trialId, createdAt])
  @@index([storeId, type])
}

model CashRegisterSession {
  id                      Int                      @id @default(autoincrement())
  storeId                 Int
  storeLocationId         Int?
  mode                    String                   @default("automatic")
  businessDate            DateTime?
  openingAmount           Decimal                  @default(0) @db.Decimal(10, 2)
  expectedAmount          Decimal?                 @db.Decimal(10, 2)
  closingAmount           Decimal?                 @db.Decimal(10, 2)
  receivedAmount          Decimal?                 @db.Decimal(10, 2)
  differenceAmount        Decimal?                 @db.Decimal(10, 2)
  openedAt                DateTime                 @default(now())
  closedAt                DateTime?
  openedByUserId          Int?
  closedByUserId          Int?
  notes                   String?
  summary                 Json?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  store                   Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeLocation           StoreLocation?           @relation(fields: [storeLocationId], references: [id], onDelete: SetNull)
  orders                  Order[]
  payments                Payment[]
  currentAccountMovements CurrentAccountMovement[]
  manualReturns           ManualReturn[]

  @@index([storeId, mode, openedAt])
  @@index([storeId, storeLocationId, mode, openedAt])
  @@index([storeId, closedAt])
  @@index([storeId, businessDate])
}

model Discount {
  id                 Int                   @id @default(autoincrement())
  storeId            Int
  name               String
  type               DiscountType
  value              Float?
  minimumAmount      Float?
  automatic          Boolean               @default(false)
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime              @default(now())
  scope              DiscountScope         @default(order)
  buyQuantity        Int?
  getQuantity        Int?
  coupons            Coupon[]
  store              Store                 @relation(fields: [storeId], references: [id])
  categoryTargets    DiscountCategory[]
  optionTargets      DiscountOption[]
  optionValueTargets DiscountOptionValue[]
  productTargets     DiscountProduct[]
  variantTargets     DiscountVariant[]
  orders             Order[]

  @@index([storeId])
  @@index([storeId, automatic])
}

model Coupon {
  id         Int      @id @default(autoincrement())
  code       String
  storeId    Int
  discountId Int
  usageLimit Int?
  usedCount  Int      @default(0)
  createdAt  DateTime @default(now())
  discount   Discount @relation(fields: [discountId], references: [id])
  store      Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, code])
  @@index([discountId])
}

model Shipment {
  id                          String                       @id @default(cuid())
  orderId                     Int                          @unique
  provider                    String
  method                      String
  trackingNumber              String?
  trackingUrl                 String?
  status                      ShipmentStatus               @default(pending)
  weight                      Float?
  shippingAddress             String
  postalCode                  String
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  storeId                     Int
  externalShipmentId          String?
  labelUrl                    String?
  labelFormat                 String?
  carrier                     String?
  cost                        Decimal?                     @db.Decimal(10, 2)
  conditionCode               String?
  providerPayload             Json?
  providerConfigId            String?
  internalNotes               String?
  order                       Order                        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeShippingProviderConfig StoreShippingProviderConfig? @relation(fields: [providerConfigId], references: [id])
  store                       Store                        @relation(fields: [storeId], references: [id])
  trackingEvents              ShipmentTrackingEvent[]

  @@index([storeId])
  @@index([orderId])
  @@index([providerConfigId])
}

model ShipmentTrackingEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  description String?
  location    String?
  createdAt   DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model Return {
  id                       Int          @id @default(autoincrement())
  storeId                  Int
  orderId                  Int
  reason                   String?
  adminInstructions        String?
  adminNotes               String?
  customerShipmentCarrier  String?
  customerShipmentTracking String?
  customerShipmentProofUrl String?
  status                   ReturnStatus @default(requested)
  approvedAt               DateTime?
  shippedAt                DateTime?
  receivedAt               DateTime?
  resolvedAt               DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  refund                   Refund?
  order                    Order        @relation(fields: [orderId], references: [id])
  store                    Store        @relation(fields: [storeId], references: [id])
  items                    ReturnItem[]

  @@index([storeId])
  @@index([orderId])
}

model ReturnItem {
  id          Int       @id @default(autoincrement())
  returnId    Int
  orderItemId Int
  quantity    Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  return      Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

model ManualReturn {
  id                      Int                      @id @default(autoincrement())
  storeId                 Int
  storeLocationId         Int?
  cashRegisterId          Int?
  customerId              Int?
  currentAccountId        Int?
  customerName            String?
  returnedPaymentMethod   String?
  returnedDiscountApplied Boolean                  @default(true)
  exchangeDiscountApplied Boolean                  @default(true)
  settlementMethod        String?
  notes                   String?
  totalReturned           Decimal                  @default(0) @db.Decimal(10, 2)
  totalExchange           Decimal                  @default(0) @db.Decimal(10, 2)
  differenceAmount        Decimal                  @default(0) @db.Decimal(10, 2)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  store                   Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeLocation           StoreLocation?           @relation(fields: [storeLocationId], references: [id], onDelete: SetNull)
  cashRegister            CashRegisterSession?     @relation(fields: [cashRegisterId], references: [id], onDelete: SetNull)
  customer                Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  currentAccount          CurrentAccount?          @relation(fields: [currentAccountId], references: [id], onDelete: SetNull)
  items                   ManualReturnItem[]
  events                  ManualReturnEvent[]
  accountMovements        CurrentAccountMovement[]

  @@index([storeId, createdAt])
  @@index([storeId, storeLocationId])
  @@index([cashRegisterId])
  @@index([customerId])
  @@index([currentAccountId])
}

model ManualReturnEvent {
  id             Int          @id @default(autoincrement())
  storeId        Int
  manualReturnId Int
  type           String
  message        String?
  actorId        Int?
  metadata       Json?
  createdAt      DateTime     @default(now())
  manualReturn   ManualReturn @relation(fields: [manualReturnId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([manualReturnId, createdAt])
}

model ManualReturnItem {
  id             Int            @id @default(autoincrement())
  manualReturnId Int
  storeId        Int
  variantId      Int
  kind           String
  quantity       Int
  price          Decimal        @db.Decimal(10, 2)
  createdAt      DateTime       @default(now())
  manualReturn   ManualReturn   @relation(fields: [manualReturnId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@index([manualReturnId])
  @@index([storeId, kind])
  @@index([variantId])
}

model Refund {
  id        Int      @id @default(autoincrement())
  storeId   Int
  orderId   Int
  returnId  Int?     @unique
  paymentId Int?
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  return    Return?  @relation(fields: [returnId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([orderId])
}

model Webhook {
  id         String            @id @default(uuid())
  url        String
  secret     String
  events     String[]
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  storeId    Int
  store      Store             @relation(fields: [storeId], references: [id])
  deliveries WebhookDelivery[]

  @@index([storeId])
}

model WebhookDelivery {
  id             String   @id @default(uuid())
  webhookId      String
  event          String
  payload        Json
  responseStatus Int?
  responseBody   String?
  attempt        Int      @default(0)
  delivered      Boolean  @default(false)
  createdAt      DateTime @default(now())
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  event       String
  storeId     Int
  payload     Json
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([processed])
}

model CancellationRequest {
  id           Int                       @id @default(autoincrement())
  storeId      Int
  orderId      Int                       @unique
  customerId   Int
  reason       String?
  status       CancellationRequestStatus @default(requested)
  refundAmount Decimal?                  @db.Decimal(10, 2)
  adminNotes   String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  reviewedAt   DateTime?
  customer     Customer                  @relation(fields: [customerId], references: [id])
  order        Order                     @relation(fields: [orderId], references: [id])
  store        Store                     @relation(fields: [storeId], references: [id])

  @@index([customerId])
  @@index([storeId, status])
}

model DiscountCategory {
  discountId Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([categoryId])
}

model DiscountOption {
  discountId      Int
  productOptionId Int
  discount        Discount      @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productOption   ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  @@id([discountId, productOptionId])
  @@index([productOptionId])
}

model DiscountOptionValue {
  discountId      Int
  productOptionId Int
  value           String
  discount        Discount      @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productOption   ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  @@id([discountId, productOptionId, value])
  @@index([productOptionId, value])
}

model DiscountProduct {
  discountId Int
  productId  Int
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
}

model DiscountVariant {
  discountId     Int
  variantId      Int
  discount       Discount       @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([discountId, variantId])
  @@index([variantId])
}

model InboundWebhookEvent {
  id          String    @id
  provider    String
  event       String
  payloadHash String
  externalId  String?
  payload     Json
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, payloadHash])
  @@index([provider, event])
}

model ShippingQuote {
  id                          String                       @id @default(cuid())
  storeId                     Int
  cartId                      Int
  customerId                  Int
  provider                    String
  method                      String
  price                       Decimal                      @db.Decimal(10, 2)
  estimatedDays               Int
  postalCode                  String
  state                       String?
  city                        String?
  country                     String?
  weight                      Float?
  declaredValue               Decimal?                     @db.Decimal(10, 2)
  carrierId                   String?
  carrierName                 String?
  serviceCode                 String?
  modalityCode                String?
  dispatchType                String?
  branchId                    String?
  sellerCost                  Decimal?                     @db.Decimal(10, 2)
  providerConfigId            String?
  expiresAt                   DateTime
  consumedAt                  DateTime?
  metadata                    Json?
  createdAt                   DateTime                     @default(now())
  orders                      Order[]
  storeShippingProviderConfig StoreShippingProviderConfig? @relation(fields: [providerConfigId], references: [id])
  store                       Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([providerConfigId])
  @@index([storeId, customerId, cartId, createdAt])
  @@index([storeId, expiresAt])
}

model StoreShippingMethod {
  id                        String    @id @default(cuid())
  storeId                   Int
  name                      String
  type                      String
  price                     Decimal   @default(0) @db.Decimal(10, 2)
  freeShippingMinimumAmount Decimal?  @db.Decimal(10, 2)
  estimatedDays             Int?
  description               String?
  pickupAddress             String?
  pickupHours               String?
  pickupInstructions        String?
  active                    Boolean   @default(true)
  displayOrder              Int       @default(0)
  deletedAt                 DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  store                     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, active, displayOrder])
  @@index([storeId, deletedAt])
}

model StoreShippingProviderConfig {
  id              String          @id @default(cuid())
  storeId         Int
  provider        String
  enabled         Boolean         @default(true)
  isDefault       Boolean         @default(false)
  mode            String?         @default("DEFAULT")
  email           String?
  password        String?
  agreement       String?
  apiKey          String?
  secretKey       String?
  originBranch    String?
  originAddressId String?
  senderName      String?
  senderPhone     String?
  senderEmail     String?
  companyName     String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orders          Order[]
  shipments       Shipment[]
  shippingQuotes  ShippingQuote[]
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([storeId, enabled, isDefault])
  @@index([storeId, provider])
}

enum OrderStatus {
  pending
  paid
  shipped
  cancelled
  processing
  packed
  ready_for_pickup
  picked_up
  delivered
  refunded
}

enum ShipmentStatus {
  pending
  created
  picked_up
  in_transit
  out_for_delivery
  delivered
  failed
  returned
}

enum DiscountType {
  percentage
  fixed_amount
  free_shipping
  buy_x_get_y
}

enum ReturnStatus {
  requested
  approved
  received
  resolved
  rejected
  refunded
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  STAFF
}

enum PaymentStatus {
  pending
  approved
  rejected
  cancelled
  refunded
}

enum CurrentAccountMovementType {
  SALE
  PAYMENT
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
  CREDIT_NOTE
}

enum CancellationRequestStatus {
  requested
  approved
  rejected
  refunded
}

enum DiscountScope {
  order
  product
  category
  variant
  option_value
  option
}
