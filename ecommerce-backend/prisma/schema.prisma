generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        Int      @id @default(autoincrement())
  name      String
  domain    String   @unique
  createdAt DateTime @default(now())
  webhooks Webhook[]
  carts      Cart[]
  payments   Payment[]
  products   Product[]
  categories Category[]
  customers  Customer[]
  customerAddresses CustomerAddress[]
  orders     Order[]
  users      User[]
  discounts  Discount[]
  shipments  Shipment[]
  productOptions ProductOption[]

  returns Return[]
  refunds Refund[]

  @@index([domain])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String
  storeId   Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  store    Store             @relation(fields: [storeId], references: [id])
  products ProductCategory[]

  @@unique([slug, storeId])
  @@index([storeId])
}

model ProductCategory {
  productId  Int
  categoryId Int

  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
}

model Product {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  slug      String
  published Boolean @default(false)

  storeId   Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  store      Store             @relation(fields: [storeId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  categories ProductCategory[]
  optionValues ProductOptionValue[]

  @@unique([slug, storeId])
  @@index([storeId, published])
}

model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int
  url       String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id])
}

model ProductVariant {
  id        Int       @id @default(autoincrement())
  productId Int

  sku       String    @unique
  price     Decimal   @db.Decimal(10, 2)

  Size   String?   // Size
  Color   String?   // Color

  deletedAt DateTime?

  weight Float?
  width  Float?
  height Float?
  length Float?

  product Product @relation(fields: [productId], references: [id])

  inventories Inventory[]

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model ProductOption {
  id        Int      @id @default(autoincrement())
  name      String
  storeId   Int
  createdAt DateTime @default(now())

  store  Store               @relation(fields: [storeId], references: [id])
  values ProductOptionValue[]

  @@unique([storeId, name])
  @@index([storeId])
}

model ProductOptionValue {
  id              Int      @id @default(autoincrement())
  productOptionId Int
  productId       Int
  value           String
  createdAt       DateTime @default(now())

  productOption ProductOption @relation(fields: [productOptionId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([productOptionId, productId, value])
  @@index([productOptionId])
  @@index([productId])
}

model Inventory {
  id Int @id @default(autoincrement())

  storeId   Int
  variantId Int

  quantity Int
  reserved Int @default(0)

  updatedAt DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([storeId, variantId])
  @@index([storeId])
}

model Order {
  id Int @id @default(autoincrement())

  storeId    Int
  customerId Int
  deletedAt  DateTime?

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  discountCode String?
  shipment     Shipment?
  status       OrderStatus

  shippingProvider String?
  shippingMethod   String?
  shippingCost     Decimal? @db.Decimal(10, 2)

  idempotencyKey String?

  createdAt DateTime @default(now())

  payments Payment[]

  store    Store    @relation(fields: [storeId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  items OrderItem[]

  returns Return[]
  refunds Refund[]

  discount   Discount? @relation(fields: [discountId], references: [id])
  discountId Int?

  @@unique([storeId, idempotencyKey])
  @@index([storeId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  variantId Int
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  returnedQuantity Int @default(0)

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  returnItems ReturnItem[]

  @@index([orderId])
}

enum OrderStatus {
  pending
  paid
  processing
  packed
  shipped
  delivered
  cancelled
  refunded
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?

  role Role

  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  createdAt DateTime @default(now())

  @@index([storeId])
}

model Customer {
  id Int @id @default(autoincrement())

  storeId Int
  store   Store @relation(fields: [storeId], references: [id])
  
  email     String
  firstName String?
  lastName  String?
  phone     String?
  password String?   // 🔥 AGREGAR
  carts     Cart[]
  orders    Order[]
  addresses CustomerAddress[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  @@unique([storeId, email])
  @@index([storeId])
}

model CustomerAddress {
  id Int @id @default(autoincrement())

  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  firstName String
  lastName  String
  phone     String?

  address1 String
  address2 String?

  city    String
  state   String?
  zip     String
  country String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([storeId])
}

model Cart {
  id Int @id @default(autoincrement())

  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  status String @default("active")

  items CartItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([storeId])
  @@index([customerId])
}

model CartItem {
  id Int @id @default(autoincrement())

  cartId Int
  cart   Cart @relation(fields: [cartId], references: [id])

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int

  createdAt DateTime @default(now())

  @@index([cartId])
}

model Payment {
  id Int @id @default(autoincrement())

  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  provider String
  status   String

  amount Decimal @db.Decimal(10, 2)

  externalId String?

  idempotencyKey String?

  createdAt DateTime @default(now())

  @@unique([storeId, idempotencyKey])
  @@index([orderId])
}

model Discount {
  id Int @id @default(autoincrement())

  storeId Int
  store   Store @relation(fields: [storeId], references: [id])

  name String

  type  DiscountType
  value Float?

  minimumAmount Float?

  automatic Boolean @default(false)

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())

  coupons Coupon[]
  orders  Order[]

  @@index([storeId])
  @@index([storeId, automatic]) // 👈 NUEVO
}

model Coupon {
  id Int @id @default(autoincrement())

  code String

  discountId Int
  discount   Discount @relation(fields: [discountId], references: [id])

  usageLimit Int?
  usedCount  Int  @default(0)

  createdAt DateTime @default(now())

  @@unique([code])
  @@index([discountId])
}

enum ShipmentStatus {
  pending
  created
  picked_up
  in_transit
  out_for_delivery
  delivered
  failed
  returned
}

model Shipment {
  id String @id @default(cuid())

  storeId Int
  orderId Int @unique

  provider String
  method   String

  trackingNumber String?
  trackingUrl    String?

  status ShipmentStatus @default(pending)

  weight Float?

  shippingAddress String
  postalCode      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  trackingEvents ShipmentTrackingEvent[]

  @@index([storeId])
  @@index([orderId])
}

model ShipmentTrackingEvent {
  id String @id @default(cuid())

  shipmentId String

  status      ShipmentStatus
  description String?
  location    String?

  createdAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model Return {
  id Int @id @default(autoincrement())

  storeId Int
  orderId Int

  reason String?
  status ReturnStatus @default(requested)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  items  ReturnItem[]
  refund Refund?

  @@index([storeId])
  @@index([orderId])
}

model ReturnItem {
  id Int @id @default(autoincrement())

  returnId    Int
  orderItemId Int

  quantity Int

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([returnId])
}

model Refund {
  id Int @id @default(autoincrement())

  storeId  Int
  orderId  Int
  returnId Int @unique

  paymentId Int?

  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  store  Store  @relation(fields: [storeId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
  return Return @relation(fields: [returnId], references: [id])

  @@index([storeId])
  @@index([orderId])
}

model Webhook {
  id        String   @id @default(uuid())

  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])

  url       String
  secret    String
  events    String[]

  isActive  Boolean  @default(true)

  deliveries WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}
model WebhookDelivery {
  id             String   @id @default(uuid())

  webhookId      String
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  event          String
  payload        Json

  responseStatus Int?
  responseBody   String?

  attempt        Int      @default(0)
  delivered      Boolean  @default(false)

  createdAt      DateTime @default(now())

  @@index([webhookId])
}
model OutboxEvent {
  id        String   @id @default(uuid())

  event     String
  storeId   Int

  payload   Json

  processed Boolean  @default(false)

  createdAt DateTime @default(now())
  processedAt DateTime?

  @@index([processed])
}
enum DiscountType {
  percentage
  fixed_amount
  free_shipping
}

enum ReturnStatus {
  requested
  approved
  rejected
  refunded
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum PaymentStatus {
  pending
  approved
  rejected
  cancelled
  refunded
}
